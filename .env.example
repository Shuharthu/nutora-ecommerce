# ==============================================================================
# NUTORA E-COMMERCE — ENVIRONMENT CONFIGURATION
# Copy this file to .env and replace placeholders with your credentials
# ==============================================================================

# Supabase Project Credentials (Found in Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...public-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...server-only-service-role-key

# Initial One-Time Super Admin Setup Credentials
INITIAL_ADMIN_EMAIL=admin@nutorafood.com
INITIAL_ADMIN_PASSWORD=change-this-secure-password

# Payment Gateway (SSLCommerz Bangladesh)
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASS=your_store_passwd
SSLCOMMERZ_IS_SANDBOX=true

# Store Logistics Defaults
DEFAULT_SHIPPING_DHAKA=70
DEFAULT_SHIPPING_OUTSIDE=130
FREE_SHIPPING_THRESHOLD_DHAKA=1500
