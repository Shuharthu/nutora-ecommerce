{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/admin/index", "destination": "/admin/index.html" },
    { "source": "/admin/products", "destination": "/admin/products.html" },
    { "source": "/admin/categories", "destination": "/admin/categories.html" },
    { "source": "/admin/inventory", "destination": "/admin/inventory.html" },
    { "source": "/admin/orders", "destination": "/admin/orders.html" },
    { "source": "/admin/customers", "destination": "/admin/customers.html" },
    { "source": "/admin/coupons", "destination": "/admin/coupons.html" },
    { "source": "/admin/reviews", "destination": "/admin/reviews.html" },
    { "source": "/admin/users", "destination": "/admin/users.html" },
    { "source": "/admin/settings", "destination": "/admin/settings.html" },
    { "source": "/admin/audit-logs", "destination": "/admin/audit-logs.html" },
    { "source": "/admin/login", "destination": "/admin/login.html" },
    { "source": "/admin/setup", "destination": "/admin/setup.html" },
    { "source": "/products", "destination": "/admin/products.html" },
    { "source": "/orders", "destination": "/admin/orders.html" },
    { "source": "/categories", "destination": "/admin/categories.html" },
    { "source": "/inventory", "destination": "/admin/inventory.html" },
    { "source": "/customers", "destination": "/admin/customers.html" },
    { "source": "/coupons", "destination": "/admin/coupons.html" },
    { "source": "/reviews", "destination": "/admin/reviews.html" },
    { "source": "/users", "destination": "/admin/users.html" },
    { "source": "/audit-logs", "destination": "/admin/audit-logs.html" },
    { "source": "/admin/:slug", "destination": "/admin/:slug.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
